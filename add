            os.queueEvent("redraw_screen"); os.queueEvent("audio_update")
          end
        end)
    end
  end

  return uiLoop, audioLoop, httpLoop
end

local function protect(name, fn)
  return function()
    while not unlocked do
      local ok, err = pcall(fn)
      if unlocked then return end
      if not ok then
        if tostring(err) ~= "Terminated" then
          log("ERR: [" .. name .. "] " .. tostring(err))
        end
      end
      local sok = pcall(os.sleep, 0.1)
      if not sok then pcall(coroutine.yield, "sleep", 0.1) end
    end
  end
end

