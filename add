            while is_paused and not unlocked do os.pullEvent("audio_update"); if not playing or playing_id ~= id then break end end
            if not playing or playing_id ~= id or unlocked then break end
            local chunk = player_handle and player_handle.read(chunk_size or CFG.audioChunk)
