              break
            else
              if first_chunk then chunk = first_chunk .. chunk; first_chunk = nil; chunk_size = CFG.audioChunk end
              if not decoder then
                is_error = true; playing = false
                if player_handle then pcall(function() player_handle.close() end); player_handle = nil end
                os.queueEvent("redraw_screen"); os.queueEvent("audio_update"); break
              end
