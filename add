          if now - lastRefresh >= CFG.refreshMs then lastRefresh = now; refreshData() end
          if eye then
            local allPlayers = combinedPlayers()
            for i = 1, #trackPool do
              if stealthMode or exitPending then return end
              local bp = trackPool[i]
              if bp then
                local pl = allPlayers[i]
                if pl and (not pl.dist or pl.dist <= C.highlightMaxDistance) then
                  local sx, sy, sz = getSmoothPos(pl.name)
                  if sx then
                    local target = highlightScale(pl.dist or 0)
                    local sc = boxScale[pl.name]
                    if sc == nil then sc = target
                    else sc = sc * (1 - C.highlightSmooth) + target * C.highlightSmooth end
                    boxScale[pl.name] = sc
                    local yaw = pl.yaw or 0
                    local fx = -math.sin(math.rad(yaw)); local fz = math.cos(math.rad(yaw))
                    local bW, bH, bD, posY, off
                    if pl.lying then
                      if math.abs(fz) >= math.abs(fx) then bW,bH,bD = CFG.boxLie.short*sc,CFG.boxLie.h*sc,CFG.boxLie.long*sc else bW,bH,bD = CFG.boxLie.long*sc,CFG.boxLie.h*sc,CFG.boxLie.short*sc end
                      posY = sy + 0.2*sc; off = 0
                    elseif pl.sneaking then
                      bW,bH,bD = CFG.boxSneak.w*sc,CFG.boxSneak.h*sc,CFG.boxSneak.d*sc; posY = sy+0.75*sc; off = 0.15*sc
                    else
                      bW,bH,bD = CFG.boxStand.w*sc,CFG.boxStand.h*sc,CFG.boxStand.d*sc; posY = sy+0.9*sc; off = 0
                    end
                    local color = getPlayerHighlightColor(pl)
                    if color then
                      setBoxSmart(i, bp, sx+fx*off, posY, sz+fz*off, bW,bH,bD, color)
                    else disableBoxSmart(i, bp) end
                  end
                else disableBoxSmart(i, bp) end
              end
            end
          end
        end)
        os.sleep(CFG.tickSleep)
      end
    end
  end
end

