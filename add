local function nearestPlayer(x, y, z)
  local best, bd = nil, math.huge
  local okO, online = pcall(detector.getOnlinePlayers)
  if not okO or type(online) ~= "table" then return nil end
  for _, n in ipairs(online) do
    local okP, p = pcall(detector.getPlayer, n)
    if okP and type(p)=="table" and p.x then
      local d = math.sqrt((p.x-x)^2 + (p.z-z)^2)
      if d < bd then bd, best = d, n end
    end
  end
  return best
end

