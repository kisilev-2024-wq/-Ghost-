            os.queueEvent("redraw_screen")
          elseif url == last_download_url then
            local hdr = h2.getResponseHeaders()
            local isAudio = false
            if hdr and hdr["Content-Type"] then
              local ct = hdr["Content-Type"]:lower()
              if ct:find("audio") or ct:find("octet-stream") or ct:find("dfpwm") then isAudio = true end
            end
            if not isAudio then
              is_loading = false; is_error = true; playing = false; playing_id = nil; is_paused = false; pcall(function() h2.close() end)
              os.queueEvent("redraw_screen"); os.queueEvent("audio_update")
            else
              is_loading = false
              if playing_id then
                local cp = getCachePath(playing_id)
                local ok, ch = pcall(realFs.open, cp, "wb")
                if ok and ch then
                  local ad = h2.readAll(); ch.write(ad); ch.close()
