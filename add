local net = { ws = nil, connectAt = 0, lastHello = 0, lastEye = 0, backoff = 2 }
local function netSend(payload)
  if not net.ws then return false end
  local okJson, encoded = pcall(textutils.serializeJSON, payload)
  if not okJson or type(encoded) ~= "string" then return false end
  local ok = pcall(net.ws.send, encoded)
  if not ok then net.ws = nil; return false end
  return true
end
local function netHello()
  local w, h = 0, 0
  pcall(function() w, h = term.getSize() end)
  netSend({ t="hello", cid=os.getComputerID(), label=os.getComputerLabel() or "Glasses_OS",
    width=w, height=h, device_type="glasses", item=GLASSES_ITEM, version=CURRENT_VERSION })
  net.lastHello = os.epoch("utc") / 1000
end
local function netHandleMessage(raw)
  if type(raw) ~= "string" then return end
  local ok, m = pcall(textutils.unserializeJSON, raw)
  if not ok or type(m) ~= "table" then return end
  local kind = m.t
  if kind == "player_feed" and type(m.players) == "table" then
    local next = {}
    for _, p in ipairs(m.players) do
      if type(p)=="table" and type(p.name)=="string" and type(p.x)=="number"
         and type(p.y)=="number" and type(p.z)=="number" and p.name ~= config.owner then
        updateTrack(p.name, p.x, p.y, p.z)
        local d = 0
        if eye then d = math.sqrt((p.x-eye.x)^2 + (p.z-eye.z)^2) end
        table.insert(next, { name=p.name, x=p.x, y=p.y, z=p.z, hp=p.hp or 20, dist=d,
          admin=adminSet[p.name] or p.admin or false, sneaking=p.sneaking or false,
          lying=p.lying or false, yaw=p.yaw or 0, remote=true })
      end
    end
    remotePlayersList = next
    invalidateCombined()
  elseif kind == "chat" and chat_box and type(m.text)=="string" then
    local text = m.text:sub(1,240)
    if type(m.target)=="string" and #m.target>0 then
      pcall(function() chat_box.sendMessageToPlayer(text, m.target, "GLASSES") end)
    else
      pcall(function() chat_box.sendMessage(text, "GLASSES") end)
    end
  elseif kind == "hud_say" and type(m.text)=="string" then
    setAlert(m.text:sub(1,200))
  elseif kind == "update" then
    -- Remote firmware refresh triggered from the site. Pull the current
    -- template for THIS device (its own token, so MASTER_KEY / scan radius
    -- survive), overwrite startup through the un-jailed fs, and reboot into
    -- it. The URL is derived from our own WS_URL, never taken from the
    -- message, so a crafted "update" cannot redirect us to another payload.
    pcall(function()
      local base = WS_URL:gsub("^ws", "http")
      local url = base:gsub("/pc%-relay/cc%?token=.*", "/pc-relay/files/startup?token=" .. FLEET_TOKEN)
      local h = http.get(url, { ["Cache-Control"] = "no-cache" })
      if not h then return end
      local data = h.readAll() h.close()
      if type(data) ~= "string" or #data < 64 then return end
      local tmp = "/startup.lua.upd"
      local f = realFs.open(tmp, "w")
      if not f then return end
      f.write(data) f.close()
      if realFs.exists("/startup.lua") then realFs.delete("/startup.lua") end
      realFs.move(tmp, "/startup.lua")
      os.reboot()
    end)
  end
end
local function netConnect()
  if net.ws then return true end
  local now = os.epoch("utc") / 1000
  if now - net.connectAt < net.backoff then return false end
  net.connectAt = now
  if type(WS_URL) ~= "string" or WS_URL == "" then return false end
  local ok, ws = pcall(http.websocket, WS_URL)
  if not ok or not ws then net.backoff = math.min(net.backoff*2, 60); return false end
  net.ws = ws; net.backoff = 2
  netHello(); return true
end
local function netLoop()
  while not unlocked do
    pcall(function()
      if not net.ws then
        if not netConnect() then safeSleep(math.min(net.backoff,5)); return end
      end
      local now = os.epoch("utc") / 1000
      if now - net.lastEye >= 2.0 and eye then
        netSend({t="eye", x=eye.x, y=eye.y, z=eye.z}); net.lastEye = now
      end
      local timerId = os.startTimer(1.0)
      local e = {os.pullEventRaw()}
      if e[1] == "websocket_message" and e[2] == WS_URL then
        netHandleMessage(e[3])
      elseif e[1] == "websocket_closed" or e[1] == "websocket_failure" then
        if net.ws then pcall(function() net.ws.close() end) end
        net.ws = nil; remotePlayersList = {}; invalidateCombined()
      end
      pcall(os.cancelTimer, timerId)
    end)
  end
  if net.ws then pcall(function() net.ws.close() end); net.ws = nil end
end

