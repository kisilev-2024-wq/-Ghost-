local function updateTrack(name, x, y, z)
  local now = os.epoch("utc")
  local tr = track[name]
  if not tr or not tr.lt then
    track[name] = {lx=x,ly=y,lz=z,lt=now,vx=0,vy=0,vz=0}
  else
    local dt = (now - tr.lt) / 1000
    if dt > 0.001 then
      local ivx=(x-tr.lx)/dt; local ivy=(y-tr.ly)/dt; local ivz=(z-tr.lz)/dt
      local sp = math.sqrt(ivx*ivx+ivy*ivy+ivz*ivz)
      if sp > 20 then local s=20/sp; ivx=ivx*s; ivy=ivy*s; ivz=ivz*s end
      tr.vx=tr.vx*0.5+ivx*0.5; tr.vy=tr.vy*0.5+ivy*0.5; tr.vz=tr.vz*0.5+ivz*0.5
    end
    tr.lx=x; tr.ly=y; tr.lz=z; tr.lt=now
  end
end
local function getSmoothPos(name)
  local tr = track[name]; if not tr or not tr.lx then return nil,nil,nil end
  local now = os.epoch("utc")
  local dt = (now - tr.lt)/1000
  if dt < 0 then dt = 0 end
  if dt > 0.25 then dt = 0.25 end
  return tr.lx+tr.vx*dt, tr.ly+tr.vy*dt, tr.lz+tr.vz*dt
end
local function getPlayerPose(p)
  local sn = (p.isSneaking==true) or (p.sneaking==true) or (p.isCrouching==true)
  local ly = (p.isSleeping==true) or (p.sleeping==true) or (p.isLying==true)
  local eh = p.eyeHeight
  if eh then
    if eh < 0.6 then ly = true; sn = false
    elseif eh < 1.5 then sn = true; ly = false end
  end
  return sn, ly
end

local function refreshData()
  if overlay then
    local ok, x, y, z = pcall(overlay.getEyePosition)
    if ok and type(x) == "number" then eye = {x=x,y=y,z=z} end
  end
  if not detector then playersList = {}; invalidateCombined(); return end
  local okO, online = pcall(detector.getOnlinePlayers)
  online = (okO and type(online)=="table") and online or {}
  local all = {}
  for _, name in ipairs(online) do
    local okP, p = pcall(detector.getPlayer, name)
    if okP and type(p)=="table" and p.x then
      local d = 0
      if eye then d = math.sqrt((p.x-eye.x)^2 + (p.z-eye.z)^2) end
      updateTrack(name, p.x, p.y, p.z)
      local sn, ly = getPlayerPose(p)
      table.insert(all, {name=name, x=p.x, y=p.y, z=p.z, hp=p.health or 20, dist=d, admin=adminSet[name] or false, sneaking=sn, lying=ly, yaw=p.yaw or 0, remote=false})
    end
  end
  local wearer = config.owner
  if wearer == "" or wearer == "Unknown" then
    local best = 1e9
    for _, r in ipairs(all) do if r.dist < best then best = r.dist; wearer = r.name end end
  end
  local filtered = {}
  for _, r in ipairs(all) do if r.name ~= wearer then filtered[#filtered+1] = r end end
  table.sort(filtered, function(a,b) return a.dist < b.dist end)
  playersList = filtered
  local cur = {}
  for _, r in ipairs(all) do cur[r.name] = true end
  for n in pairs(track) do if not cur[n] then track[n] = nil end end
  for n in pairs(boxScale) do if not cur[n] then boxScale[n] = nil end end
  invalidateCombined()
end

local function combinedPlayers()
  if combinedCache and not combinedDirty then return combinedCache end
  local out = {}
  for _, p in ipairs(playersList) do out[#out+1] = p end
  for _, p in ipairs(remotePlayersList) do out[#out+1] = p end
  table.sort(out, function(a,b) return (a.dist or 1e9) < (b.dist or 1e9) end)
  combinedCache = out
  combinedDirty = false
  return out
end

local function highlightScale(d)
  if d <= C.highlightNormalDist then return 1 end
  if d >= C.highlightMaxDistance then return C.highlightMaxScale end
  local t = (d - C.highlightNormalDist) / (C.highlightMaxDistance - C.highlightNormalDist)
  local s = t * t * (3 - 2 * t)
  return 1 + s * (C.highlightMaxScale - 1)
end
local function getPlayerHighlightColor(pl)
  if pl.remote then return C.cyan end
  if pl.admin then return C.red end
  if isFriend(pl.name) and pl.name ~= config.owner then return C.pink end
  if pl.sneaking then return C.yellow end
  return C.green
end

