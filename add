  local function invertChar(ch)
    local up = ch == string.upper(ch) and ch ~= string.lower(ch)
    local m = QWERTY_TO_RU[string.lower(ch)]
    if m then return up and string.upper(m) or m end
    return ch
  end
  local function invertString(s)
    if type(s) ~= "string" then return s end
