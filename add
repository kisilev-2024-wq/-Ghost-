      end
    end
    if tab == 3 then
      if y == 3 then
        if x >= 2 and x <= 12 then chat_mode = 1; chat_error = nil; saveSettings()
        elseif x >= 14 and x <= 26 then chat_mode = 2; chat_error = nil; saveSettings() end
      elseif y == 5 then chat_input_focus = 1; input_context = "chat_target"; input_buffer = chat_target
      elseif y == 7 then chat_input_focus = 2; input_context = "chat_msg"; input_buffer = chat_message
      elseif y == 9 and x >= 2 and x <= 8 then if sendChatMessage(chat_message) then chat_message = "" end end
      redrawScreen(); return
    end
    if tab == 1 then
      if y == 6 then
        if x >= 2 and x <= 9 then
          if is_paused then is_paused = false; os.queueEvent("audio_update")
          elseif playing then is_paused = true; for _, s in ipairs(speakers) do pcall(function() s.stop() end) end; os.queueEvent("audio_update")
          elseif now_playing then playing_id = nil; playing = true; is_error = false; is_paused = false; os.queueEvent("audio_update")
          elseif #queue > 0 then now_playing = queue[1]; table.remove(queue,1); playing = true; playing_id = nil; is_error = false; is_paused = false; os.queueEvent("audio_update") end
