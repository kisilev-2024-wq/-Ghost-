      if not sent then sent, err = trySend(msg, {prefix="Definitely not console", utf8=true}) end
      if not sent then sent, err = trySend(msg, {utf8=true}) end
    else
      if chat_target == "" then chat_error = "Target empty"; return false end
      sent, err = trySend(msg, {player=chat_target, prefix="PM", utf8=true})
      if not sent then sent, err = trySend(msg, {player=chat_target, utf8=true}) end
